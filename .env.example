# Copia este archivo a .env.local y completa los valores.
# .env.local está en .gitignore: nunca subas claves al repositorio.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API, en el panel de Supabase.
#
# SIN prefijo NEXT_PUBLIC_. La anon key está diseñada para ser pública y podría
# llevarlo sin riesgo, pero ningún componente de cliente de esta aplicación usa
# Supabase: todo pasa por el servidor. El prefijo habría puesto en el paquete
# del navegador dos valores que nadie iba a leer ahí.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# La service_role key NO va acá ni en ninguna parte. Se salta todas las
# políticas de la base, así que cualquier error de la aplicación se convertiría
# en una filtración. Esta aplicación no la necesita: todo pasa por RLS con la
# sesión de quien opera.

# ── Análisis de fotos ────────────────────────────────────────────────────────
# Clave de la API de Anthropic, para identificar productos desde la foto.
#
# SIN prefijo NEXT_PUBLIC_, y es deliberado: esta clave se usa solo en el
# servidor. Con ese prefijo terminaría en el paquete del navegador y cualquiera
# podría gastarla.
#
# Es OPCIONAL. Sin ella el inventario funciona completo y solo deja de andar el
# análisis automático, que la pantalla informa en vez de fallar.
ANTHROPIC_API_KEY=
